generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used by the running site)
  directUrl = env("DIRECT_URL") // direct connection (used by prisma db push)
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

/// A clothing label sold in the shop (our own Sakeena's line, or any other brand we stock).
model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String    @default("")
  logo        String    @default("") // uploaded image URL
  active      Boolean   @default(true)
  products    Product[]
}

model Product {
  id              String      @id @default(cuid())
  brandId         String?
  brand           Brand?      @relation(fields: [brandId], references: [id])
  name            String
  slug            String      @unique
  description     String
  price           Int // PKR, before discount
  discountPercent Int         @default(0)
  images          String      @default("") // one URL per line
  sizes           String      @default("S,M,L,XL") // comma separated
  colors          String      @default("") // comma separated
  stock           Int         @default(0)
  featured        Boolean     @default(false)
  active          Boolean     @default(true)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  movements       StockMovement[]
  sizeStocks      ProductSize[]
  reviews         Review[]
}

/// Stock per size. Product.stock always holds the total of these rows.
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
}

/// Customer reviews. Only shown on the site after an admin approves them.
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Homepage hero slides, editable in the admin.
model Banner {
  id       String  @id @default(cuid())
  title    String
  subtitle String  @default("")
  image    String
  href     String  @default("/shop")
  sort     Int     @default(0)
  active   Boolean @default(true)
}

/// Staff accounts. The owner signs in with ADMIN_EMAIL / ADMIN_PASSWORD from the environment.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // STAFF can manage orders/products/stock; owner-only: sales, staff, coupons, deleting
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

/// Used to slow down password guessing on the admin login.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Every change to stock is logged here: orders, cancellations and manual edits.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  change    Int // negative = stock out, positive = stock in
  after     Int // stock level after this change
  reason    String // ORDER, CANCEL, RESTORE, MANUAL
  ref       String? // order number, if any
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Coupon {
  id        String  @id @default(cuid())
  code      String  @unique
  percent   Int
  active    Boolean @default(true)
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  name          String
  phone         String
  email         String?
  address       String
  city          String
  notes         String?
  subtotal      Int
  discount      Int         @default(0)
  shipping      Int
  total         Int
  couponCode    String?
  paymentMethod String
  paymentStatus String      @default("PENDING")
  paymentRef    String? // customer's transaction / reference id
  deliveredAt   DateTime?
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  trackingId    String?     @unique // unguessable id used in the customer's tracking link
  codConfirmed  Boolean     @default(false) // customer confirmed a COD order by phone
  courier       String? // e.g. TCS, Leopards, Trax, PostEx
  courierTrackingNo String?
  courierUrl    String? // optional link to the courier's tracking page
  items         OrderItem[]
  events        OrderEvent[]
}

/// Timeline of an order: one row each time its status changes.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  size      String
  color     String?
  price     Int // final unit price
  qty       Int
}

model Image {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String
  createdAt DateTime @default(now())
}
